{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["index.ts", "shared/**/*.ts", "server/**/*.ts", "extension/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts", "vitest.config.ts"]
}
